{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 600,
  "params": [
    {
      "name": "MapZoom",
      "value": 45000,
      "bind": {"input": "range", "min": 10000, "max": 150000, "step": 1000, "name": "Zoom Level "}
    },
    {
      "name": "MapCenterLon",
      "value": 145.0,
      "bind": {"input": "range", "min": 144.0, "max": 146.0, "step": 0.01, "name": "Pan Left/Right "}
    },
    {
      "name": "MapCenterLat",
      "value": -37.85,
      "bind": {"input": "range", "min": -38.5, "max": -37.0, "step": 0.01, "name": "Pan Up/Down "}
    }
  ],
  "projection": {
    "type": "mercator",
    "scale": {"expr": "MapZoom"},
    "center": {"expr": "[MapCenterLon, MapCenterLat]"}
  },
  "layer": [
    {
      "comment": "LAYER 0: MELBOURNE SUBURBS",
      "data": {
        "url": "data/vic_suburbs.topojson",
        "format": {
          "type": "topojson",
          "feature": "vic_suburbs"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#f0f2f5",
        "stroke": "#ffffff"
      }
    },
    {
      "comment": "LAYER 1: TRAIN LINES (INTERACTIVE)",
      "data": {
        "url": "data/cleaned/clean_train_shapes.csv",
        "format": {
          "type": "csv",
          "parse": {
            "sequence_order": "number",
            "latitude": "number",
            "longitude": "number"
          }
        }
      },
      "params": [
        {
          "name": "LineSelection",
          "select": {"type": "point", "fields": ["train_line_name"]},
          "bind": "legend"
        }
      ],
      "mark": {
        "type": "line",
        "strokeWidth": 3
      },
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "detail": {"field": "shape_id", "type": "nominal"},
        "color": {
          "field": "train_line_name",
          "type": "nominal",
          "legend": {
            "title": "Train Lines (Click to filter)",
            "symbolType": "stroke",
            "symbolStrokeWidth": 4
          }
        },
        "order": {"field": "sequence_order", "type": "quantitative"},
        "opacity": {
          "condition": {"param": "LineSelection", "empty": false, "value": 1},
          "value": 0.05
        },
        "tooltip": [
          {"field": "train_line_name", "type": "nominal", "title": "Line"}
        ]
      }
    },
    {
      "comment": "LAYER 2: STATIONS (FILTERED BY SUBSTRING MATCH)",
      "data": {
        "url": "data/cleaned/station_volumes_2024_2025.csv",
        "format": {
          "parse": {"daily_passenger_volume": "number"}
        }
      },
      "transform": [
        {
          "filter": "!LineSelection.train_line_name || indexof(datum.train_line_name, LineSelection.train_line_name[0]) >= 0"
        }
      ],
      "mark": {
        "type": "circle",
        "opacity": 0.8,
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "longitude": {"field": "station_longitude", "type": "quantitative"},
        "latitude": {"field": "station_latitude", "type": "quantitative"},
        "size": {
          "field": "daily_passenger_volume",
          "type": "quantitative",
          "scale": {"range": [15, 250]},
          "legend": {"title": "Daily Entries/Exits"}
        },
        "order": {
          "field": "daily_passenger_volume",
          "type": "quantitative",
          "sort": "descending"
        },
        "color": {"value": "#2c3e50"},
        "tooltip": [
          {"field": "station_name", "type": "nominal", "title": "Station"},
          {"field": "train_line_name", "type": "nominal", "title": "Lines Served"},
          {"field": "daily_passenger_volume", "type": "quantitative", "title": "Daily Volume", "format": ","}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "font": "sans-serif"
  }
}