{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Top 15 busiest suburban stations (excluding City Loop).",
  "background": "transparent",
  "width": 300,
  "height": 200,
  "data": {
    "url": "data/cleaned/station_volumes_2024_2025.csv",
    "format": {
      "type": "csv", 
      "parse": {"daily_passenger_volume": "number"}
    }
  },
  "transform": [
    {"filter": "indexof(['Flinders Street','Southern Cross','Melbourne Central','Parliament','Flagstaff'], datum.station_name) == -1"},
    {
      "window": [{"op": "row_number", "as": "rank"}],
      "sort": [{"field": "daily_passenger_volume", "order": "descending"}]
    },
    {"filter": "datum.rank <= 15"}
  ],
  "mark": {"type": "bar", "color": "#009E73"},
  "encoding": {
    "y": {
      "field": "station_name", 
      "type": "nominal", 
      "title": "Station Name",
      "sort": {"field": "daily_passenger_volume", "order": "descending"}
    },
    "x": {
      "field": "daily_passenger_volume", 
      "type": "quantitative",
      "title": "Daily Passenger Volume"
    },
    "tooltip": [
      {"field": "station_name", "type": "nominal", "title": "Station"},
      {"field": "daily_passenger_volume", "type": "quantitative", "title": "Daily Passengers", "format": ",.0f"}
    ]
  },
  "config": {
  "view": {
    "fill": "#ffffff"
  }
}
}