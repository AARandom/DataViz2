{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "On-time performance by line.",
  "background": "transparent",
  "width": 400,
  "height": 250,
  "data": {"url": "data/cleaned/train_line_performance.csv"},
  "layer": [
    {
      "mark": {"type": "rule", "color": "#bdc3c7", "strokeWidth": 2},
      "encoding": {
        "x": {"field": "train_line_name", "type": "nominal", "sort": "-y"},
        "y": {
          "field": "on_time_percentage",
          "type": "quantitative",
          "scale": {"zero": false}
        },
        "y2": {"value": 250}
      }
    },
    {
      "mark": {"type": "circle", "size": 400, "opacity": 1},
      "encoding": {
        "x": {
          "field": "train_line_name",
          "type": "nominal",
          "sort": "-y",
          "title": null,
          "axis": {"labelAngle": -45}
        },
        "y": {
          "field": "on_time_percentage",
          "type": "quantitative",
          "scale": {"zero": false},
          "title": "On-Time Percentage"
        },
        "color": {
          "field": "train_line_name",
          "type": "nominal",
          "scale": {
            "domain": ["Alamein", "Belgrave", "Glen Waverley", "Lilydale", "Cranbourne", "Pakenham", "Sunbury", "Craigieburn", "Upfield", "Hurstbridge", "Mernda", "Frankston", "Stony Point", "Sandringham", "Werribee", "Williamstown", "Flemington Racecourse"],
            "range": ["#152C6B", "#152C6B", "#152C6B", "#152C6B", "#279FD5", "#279FD5", "#279FD5", "#FFBE00", "#FFBE00", "#BE1014", "#BE1014", "#028430", "#028430", "#F178AF", "#F178AF", "#F178AF", "#95979A"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "train_line_name", "type": "nominal", "title": "Train Line"},
          {"field": "on_time_percentage", "type": "quantitative", "title": "On-Time Performance", "format": ".1%"}
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#e74c3c",
        "strokeWidth": 2,
        "strokeDash": [5, 5]
      },
      "encoding": {"y": {"datum": 0.92}}
    }
  ],
  "config": {
  "view": {
    "fill": "#ffffff"
  }
}
}