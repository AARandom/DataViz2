{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Passengers by hour of day.",
  "width": 300,
  "height": 180,
  "data": {"url": "data/cleaned/vista_train_by_hour.csv"},
  "mark": {"type": "area", "opacity": 0.7, "color": "#3498db"},
  "encoding": {
    "x": {"field": "time_of_day_hour", "type": "quantitative", "title": "Hour"},
    "y": {"field": "passenger_count", "type": "quantitative", "title": "Passengers"},
    "tooltip": [{"field": "passenger_count", "type": "quantitative", "title": "Passengers"}]
  }
}
